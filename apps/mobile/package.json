{
  "name": "@semoasn/mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "dev": "pnpm run start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf .expo dist web-build",
    "lint": "pnpm -w eslint .",
    "format": "pnpm -w prettier . --write",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch --passWithNoTests"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@tanstack/react-query": "^5.101.0",
    "axios": "^1.17.0",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "^56.0.4",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-toast-message": "^2.3.3"
  },
  "private": true,
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "@types/react": "~19.1.17",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.(spec|test).[jt]s?(x)",
      "**/*.(spec|test).[jt]s?(x)"
    ]
  }
}
