{
  "name": "semoasn-mono",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": "24.16.0",
    "pnpm": "11.4.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint -- --fix",
    "typecheck": "pnpm -r typecheck",
    "dev:server": "pnpm --filter @semoasn/server dev",
    "dev:mobile": "pnpm --filter @semoasn/mobile start",
    "format": "pnpm -w prettier . --write",
    "format:check": "pnpm -w prettier . --check",
    "clean": "pnpm -r clean && pnpm -w exec rimraf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0"
  }
}
